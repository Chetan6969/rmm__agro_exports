# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Application connection: a NON-superuser role so PostgreSQL Row Level Security applies.
DATABASE_URL=postgres://rmm_app:change-me-app-password@localhost:5432/rmm_export_erp

# Admin connection used only by db:setup / db:migrate / db:seed (superuser or DB owner).
# Unix-socket form for a local postgres where your OS user is a superuser:
DATABASE_ADMIN_URL=postgres://nav@/rmm_export_erp?host=/var/run/postgresql

# Password that db:setup assigns to the rmm_app role (must match DATABASE_URL).
APP_DB_PASSWORD=change-me-app-password

# First super admin created by db:seed (if PASSWORD is empty a random one is printed).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Session lifetime in hours (sliding).
SESSION_HOURS=12
# Set true when served over HTTPS on the LAN.
COOKIE_SECURE=false
# Set true ONLY when the API runs behind a reverse proxy (nginx, IIS) that sets X-Forwarded-For.
# Left false, client IPs (login rate limit, audit log) come from the TCP connection.
TRUST_PROXY=false

# Where uploaded logos / seals / signatures are stored.
STORAGE_DIR=./storage
