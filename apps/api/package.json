{
  "name": "@rmm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:setup": "tsx --env-file-if-exists=.env src/cli.ts setup",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env src/cli.ts seed",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@rmm/shared": "workspace:*",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
