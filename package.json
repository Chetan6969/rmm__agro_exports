{
  "name": "rmm-export-erp",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @rmm/api --filter @rmm/web dev",
    "build": "pnpm --filter @rmm/web build && pnpm --filter @rmm/api build",
    "start": "pnpm --filter @rmm/api start",
    "db:setup": "pnpm --filter @rmm/api db:setup",
    "db:generate": "pnpm --filter @rmm/api db:generate",
    "db:migrate": "pnpm --filter @rmm/api db:migrate",
    "db:seed": "pnpm --filter @rmm/api db:seed",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}
