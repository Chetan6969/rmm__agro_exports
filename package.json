{
  "name": "rmm-export-erp",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @rmm/api --filter @rmm/web dev",
    "start:dev": "node scripts/dev-db.mjs start && pnpm dev",
    "build": "pnpm --filter @rmm/web build && pnpm --filter @rmm/api build",
    "start": "pnpm --filter @rmm/api start",
    "serve:lan": "node scripts/serve-lan.mjs",
    "db:setup": "pnpm --filter @rmm/api db:setup",
    "db:generate": "pnpm --filter @rmm/api db:generate",
    "db:migrate": "pnpm --filter @rmm/api db:migrate",
    "db:seed": "pnpm --filter @rmm/api db:seed",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "setup:dev": "node scripts/dev-setup.mjs",
    "db:start": "node scripts/dev-db.mjs start",
    "db:stop": "node scripts/dev-db.mjs stop",
    "db:status": "node scripts/dev-db.mjs status",
    "db:reset": "node scripts/dev-reset.mjs",
    "demo:load": "pnpm --filter @rmm/api demo",
    "demo:reset": "pnpm --filter @rmm/api demo:reset",
    "copy:load": "pnpm --filter @rmm/api copy:load",
    "copy:reset": "pnpm --filter @rmm/api copy:reset"
  }
}
